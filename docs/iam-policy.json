{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLogBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<LOG_BUCKET>",
        "arn:aws:s3:::<LOG_BUCKET>/*"
      ]
    },
    {
      "Sid": "InvokeBedrockForClassification",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:<REGION>:<ACCOUNT_ID>:inference-profile/*",
        "arn:aws:bedrock:<REGION>:<ACCOUNT_ID>:application-inference-profile/*"
      ]
    }
  ]
}
